# copy to .env; models other than "mock" need the LLM_* keys
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TOOL_MODE=native

# online service (app/)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wh
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
NODE_ID=node-1
# local | streams  (streams = LLM turns go through Redis Streams to separate worker processes)
AGENT_EXECUTOR=local
DAILY_BUDGET_USD=5

# local Claude Code CLI as a model: seats named claude-cli, claude-cli:sonnet / :haiku / :opus
# need no key here -- they use whatever `claude` is signed in with (subscription or API key).
# CLAUDE_CLI_BIN=claude            # path to the executable, if not on PATH
# CLAUDE_CLI_CONCURRENCY=4         # max CLI processes at once (each is a Node process, ~250 MB)
# CLAUDE_CLI_BARE=0                # 1 = --bare (no hooks/plugins/CLAUDE.md); bare authenticates ONLY with ANTHROPIC_API_KEY
# CLAUDE_CLI_EXTRA_ARGS=           # appended verbatim, e.g. --effort low
